---
import "@/styles/global.css";
import ParticleSphere from "@/components/ParticleSphere.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Shariar Sultan Fahim - Engineer, Full Stack, Developer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Space+Grotesk:wght@300..700&family=Syne:wght@400..800&family=Changa+One&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="text-white font-sans antialiased relative">
    <!-- Background Color Container -->
    <div class="fixed inset-0 bg-background z-[-2]"></div>
    <!-- Interactive Background Particle Sphere -->
    <ParticleSphere />
    <!-- Main Content: Smooth Scroll Area -->
    <div
      class="fixed inset-0 w-screen h-screen top-0 left-0 bg-[radial-gradient(circle_at_0%_0%,rgba(34,197,94,0.08)_0px,transparent_45%),radial-gradient(circle_at_100%_100%,rgba(34,197,94,0.05)_0px,transparent_40%)] pointer-events-none"
    >
    </div>
    <main id="smooth-scroll-content" class="min-h-screen">
      <section class="max-w-8xl mx-auto px-6 py-10">
        <slot />
      </section>
    </main>
    <!-- Scripts -->
    <script src="@/configs/gsap.config.ts"></script>
    <script src="@/scripts/smooth-scroll.ts"></script>
    <script src="@/scripts/reveal-animation.ts"></script>
  </body>
</html>
