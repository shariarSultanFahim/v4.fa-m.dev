---
import { DATA } from "@/data/content";
---

<section class="py-24 border-t border-white/10">
  <div class="mb-24">
    <span class="text-green-500 text-[10px] font-bold uppercase tracking-[0.5em] block mb-4 font-accent">Capabilities</span>
    <h2 class="text-4xl md:text-6xl font-display font-bold tracking-tight">
      Technical Strategy
    </h2>
  </div>

  <div class="space-y-20">
    {DATA.capabilities.map((service, idx) => (
      <div class="group flex flex-col md:flex-row md:items-start gap-6 md:gap-24">
        <div class="md:w-1/3">
          <span class="text-white/30 text-[10px] font-bold uppercase tracking-[0.3em] mb-2 block font-accent group-hover:text-green-500 transition-colors">
            0{idx + 1}
          </span>
          <h4 class="text-3xl md:text-4xl font-display font-bold text-white">
            {service.title}
          </h4>
        </div>
        <div class="md:w-2/3">
          <p class="text-gray-400 font-light leading-relaxed text-lg md:text-xl group-hover:text-white transition-colors duration-500">
            {service.detail}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
