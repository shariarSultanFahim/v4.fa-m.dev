---
import { DATA } from "@/data/content";
---

<section id="projects" class="py-24">
  <div class="animated-separator h-px w-full bg-white/10 mb-16 origin-left"></div>
  <div class="mb-24">
    <span class="reveal-text text-green-500 text-[10px] font-bold uppercase tracking-[0.5em] block mb-6 font-accent">Portfolio</span>
    <h2 class="reveal-text text-3xl md:text-5xl font-display font-bold tracking-tight">
      Selected Works
    </h2>
  </div>

  <div class="space-y-32">
    {DATA.projects.map((project) => (
      <div class="group">
        <div class="space-y-4">
          <span class="reveal-text text-[10px] font-bold uppercase tracking-[0.4em] text-white/40 font-accent">
            {project.tag}
          </span>
          <h3 class="reveal-text text-4xl md:text-6xl font-display font-bold tracking-tight leading-none group-hover:text-green-500 transition-colors duration-500">
            {project.title}
          </h3>
          <p class="reveal-text text-gray-400 text-xl md:text-2xl font-display font-light max-w-xl leading-snug">
            {project.desc}
          </p>
          <div class="flex gap-6 pt-4 opacity-40 group-hover:opacity-100 transition-opacity duration-700">
            {project.stack.map((stack) => (
              <span class="reveal-text text-[10px] font-bold uppercase tracking-[0.2em] font-accent text-white/70">
                {stack}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
