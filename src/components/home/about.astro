---
import { DATA } from "@/data/content";
---

<section id="about" class="py-24">
  <div class="animated-separator h-px w-full bg-white/10 mb-16 origin-left"></div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
    <div class="space-y-6">
      <span class="reveal-text text-green-500 text-[10px] font-bold uppercase tracking-[0.5em] block font-accent">Philosophy</span>
      <h2 class="reveal-text text-3xl md:text-5xl font-display font-bold leading-[1.1] tracking-tight">
        {DATA.philosophy.title}
      </h2>
    </div>
    <div class="space-y-8 pt-2">
      <p class="reveal-text text-gray-300 text-xl md:text-2xl font-display font-light leading-snug">
        {DATA.philosophy.bio}
      </p>
      <p class="reveal-text text-gray-500 text-lg leading-relaxed max-w-lg font-light">
        {DATA.philosophy.detail}
      </p>
    </div>
  </div>
</section>
