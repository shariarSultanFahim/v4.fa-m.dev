---
import { DATA } from "@/data/content";
---

<section id="skills" class="py-24 border-t border-white/10">
  <div class="mb-16">
    <span class="text-green-500 text-[10px] font-bold uppercase tracking-[0.5em] block mb-4 font-accent">Toolkit</span>
    <h2 class="text-3xl md:text-5xl font-display font-bold tracking-tight">
      Technical Arsenal
    </h2>
  </div>

  <div class="space-y-12">
    {DATA.skills.map((group) => (
      <div class="border-b border-white/10 pb-8 last:border-0">
        <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-white/30 mb-4 font-accent">
          {group.label}
        </h3>
        <div class="flex flex-wrap gap-x-10 gap-y-4">
          {group.items.map((skill) => (
            <span class="text-2xl md:text-4xl font-display font-bold text-white/40 hover:text-green-500 transition-colors duration-500 cursor-default">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
