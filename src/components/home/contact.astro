---
import { DATA } from "@/data/content";
---

<section id="contact" class="py-20 md:py-28 lg:py-40">
  <div class="animated-separator h-px w-full bg-white/10 mb-16 origin-left">
  </div>
  <div class="max-w-7xl mx-auto text-center">
    <span
      class="reveal-text text-green-500 text-[10px] font-black uppercase tracking-[0.6em] mb-12 block font-accent"
    >
      Direct Contact
    </span>
    <h2
      class="reveal-text text-5xl md:text-8xl lg:text-9xl font-display font-bold tracking-tighter mb-24 leading-[0.85] text-white"
    >
      Let's Build.
    </h2>

    <div class="flex flex-wrap justify-center items-center gap-12 md:gap-24">
      {
        DATA.socials.map((social) => (
          <a
            href={social.link}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal-pop group flex flex-col items-center gap-4"
          >
            <span class="reveal-text text-2xl md:text-4xl font-display font-bold text-white/40 group-hover:text-white transition-all duration-700">
              {social.name}
            </span>
            <div class="w-0 group-hover:w-full h-px bg-green-500/40 transition-all duration-700" />
          </a>
        ))
      }
    </div>
  </div>
</section>
