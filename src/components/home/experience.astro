---
import { DATA } from "@/data/content";
---

<section id="experience" class="py-24">
  <div class="animated-separator h-px w-full bg-white/10 mb-16 origin-left"></div>
  <div class="mb-16">
    <span class="reveal-text text-green-500 text-[10px] font-bold uppercase tracking-[0.5em] block mb-4 font-accent">Career</span>
    <h2 class="reveal-text text-3xl md:text-5xl font-display font-bold tracking-tight">
      Professional History
    </h2>
  </div>

  <div class="space-y-24">
    {DATA.experience.map((item) => (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-4">
          <span class="reveal-text text-green-500/60 text-[10px] font-bold uppercase tracking-[0.3em] font-accent">
            {item.period}
          </span>
          <h3 class="reveal-text text-2xl md:text-3xl font-display font-bold text-white mt-2">
            {item.role}
          </h3>
          <p class="reveal-text text-white/30 text-[10px] font-bold uppercase tracking-widest mt-1">
            {item.company}
          </p>
        </div>
        <div class="lg:col-span-8 space-y-3">
          {item.bullets.map((bullet) => (
            <p class="reveal-text text-lg md:text-xl font-display font-light text-gray-400">
              {bullet}
            </p>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
